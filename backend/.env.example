# Runtime connection: Supabase pooler in transaction mode (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection used by `prisma migrate`.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"
CORS_ORIGIN="http://localhost:5173"
UNUSUAL_KM_PER_DAY=1500
PORT=3000

# --- Recordatorios (feature 003) ---
# URL pública de la PWA (enlaces de correos y notificaciones)
APP_URL="http://localhost:5173"
# URL pública de este API (cabecera de baja en un clic de los correos)
API_URL="http://localhost:3000"
# Claves VAPID para Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="<public-key>"
VAPID_PRIVATE_KEY="<private-key>"
VAPID_SUBJECT="mailto:tu@correo.com"
# resend | log (log = escribe los correos en el log, para desarrollo)
EMAIL_PROVIDER="log"
EMAIL_FROM="Car Checkup <avisos@tudominio.com>"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
# Secretos aleatorios de ≥ 32 caracteres: openssl rand -base64 48
UNSUBSCRIBE_SECRET="<random-secret>"
JOBS_SECRET="<random-secret>"

# --- Donaciones (feature 004) ---
# Stripe → Developers → API keys (sk_test_… en pruebas)
STRIPE_SECRET_KEY=""
# Stripe → Developers → Webhooks (o `stripe listen` en local) → Signing secret
STRIPE_WEBHOOK_SECRET=""
# developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Id del webhook creado en la app de PayPal
PAYPAL_WEBHOOK_ID=""
# sandbox | live
PAYPAL_ENV="sandbox"
# real | fake (fake = pagos simulados; por defecto fake fuera de producción, prohibido en producción)
PAYMENTS_PROVIDER_MODE="fake"
# Correo de contacto para dudas o reembolsos
SUPPORT_EMAIL="soporte@tudominio.com"
