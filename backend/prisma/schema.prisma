// Source of truth for data types (Constitution, Principle II).
// The generated client is written to packages/shared so the frontend can `import type` from it.

generator client {
  provider            = "prisma-client"
  output              = "../../packages/shared/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum UsageType {
  CITY
  HIGHWAY
  MIXED
}

enum ReadingSource {
  INITIAL
  UPDATE
  /// Created when a service was recorded with a higher odometer (feature 002, FR-012a).
  SERVICE
}

enum ReadingOrigin {
  ONLINE
  OFFLINE_SYNC
}

enum ReviewStatus {
  OK
  NEEDS_REVIEW
}

enum MaintenanceTypeCode {
  OIL_CHANGE
  ENGINE_AIR_FILTER
  CABIN_AIR_FILTER
  TIRE_ROTATION
  ALIGNMENT_BALANCING
  TIRE_REPLACEMENT
  BRAKE_INSPECTION
  BRAKE_FLUID
  COOLANT
  SPARK_PLUGS
  TIMING_BELT
  TRANSMISSION_FLUID
  BATTERY_CHECK
}

enum BaselineSource {
  SERVICE
  PRIOR
  VEHICLE_REGISTRATION
}

enum IntervalSource {
  DEFAULT
  CITY_ADJUSTED
  CUSTOM
}

enum PaceSource {
  READINGS
  USAGE_DEFAULT
}

enum LimitingFactor {
  KM
  TIME
}

enum EmailStatus {
  OK
  BOUNCED
  COMPLAINED
}

enum NoticeKind {
  MAINTENANCE_UPCOMING
  MAINTENANCE_OVERDUE
  MILEAGE_UPDATE
}

enum NotifiedStatus {
  UPCOMING
  OVERDUE
}

enum DeliveryChannel {
  PUSH
  EMAIL
}

enum DeliveryStatus {
  SENT
  FAILED
  EXPIRED
  BOUNCED
  COMPLAINED
}

/// Application data for an authenticated Supabase user (id = auth.users.id = JWT `sub`).
model Profile {
  id                  String             @id @db.Uuid
  activeVehicleId     String?            @unique @map("active_vehicle_id") @db.Uuid
  activeVehicle       Vehicle?           @relation("ActiveVehicle", fields: [activeVehicleId], references: [id], onDelete: SetNull)
  vehicles            Vehicle[]          @relation("OwnedVehicles")
  /// Login email from the Supabase JWT (feature 003, research R9).
  email               String?            @db.VarChar(320)
  /// Last IANA time zone reported by the user's device (FR-019).
  timeZone            String             @default("America/Mexico_City") @map("time_zone") @db.VarChar(64)
  /// Next 09:00 local time at which the daily digest is due (research R6).
  nextDigestAt        DateTime           @default(now()) @map("next_digest_at") @db.Timestamptz(3)
  emailStatus         EmailStatus        @default(OK) @map("email_status")
  emailUnsubscribedAt DateTime?          @map("email_unsubscribed_at") @db.Timestamptz(3)
  pushSubscriptions   PushSubscription[]
  notices             Notice[]
  deliveries          Delivery[]
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([nextDigestAt])
  @@map("profiles")
}

model Vehicle {
  id                   String                      @id @default(uuid()) @db.Uuid
  userId               String                      @map("user_id") @db.Uuid
  user                 Profile                     @relation("OwnedVehicles", fields: [userId], references: [id], onDelete: Cascade)
  make                 String                      @db.VarChar(60)
  model                String                      @db.VarChar(60)
  catalogModelId       String?                     @map("catalog_model_id") @db.Uuid
  catalogModel         CatalogModel?               @relation(fields: [catalogModelId], references: [id], onDelete: SetNull)
  year                 Int
  nickname             String?                     @db.VarChar(40)
  licensePlate         String?                     @map("license_plate") @db.VarChar(15)
  fuelType             FuelType?                   @map("fuel_type")
  usageType            UsageType?                  @map("usage_type")
  /// Denormalized from the latest OK reading (research R7).
  currentOdometerKm    Int                         @map("current_odometer_km")
  /// Denormalized from the latest OK reading (research R7).
  lastReadingAt        DateTime                    @map("last_reading_at") @db.Timestamptz(3)
  readings             MileageReading[]
  activeFor            Profile?                    @relation("ActiveVehicle")
  services             ServiceRecord[]
  maintenanceSettings  VehicleMaintenanceSetting[]
  maintenanceEstimates MaintenanceEstimate[]
  /// Also send this vehicle's reminders by email (FR-007).
  emailReminders       Boolean                     @default(false) @map("email_reminders")
  lastKmReminderAt     DateTime?                   @map("last_km_reminder_at") @db.Timestamptz(3)
  noticeStates         MaintenanceNoticeState[]
  notices              Notice[]
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@map("vehicles")
}

model MileageReading {
  /// Generated on the client; idempotency key (research R5).
  id               String         @id @db.Uuid
  vehicleId        String         @map("vehicle_id") @db.Uuid
  vehicle          Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  odometerKm       Int            @map("odometer_km")
  readAt           DateTime       @map("read_at") @db.Timestamptz(3)
  source           ReadingSource
  origin           ReadingOrigin
  reviewStatus     ReviewStatus   @default(OK) @map("review_status")
  confirmedUnusual Boolean        @default(false) @map("confirmed_unusual")
  service          ServiceRecord?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([vehicleId, readAt(sort: Desc)])
  @@map("mileage_readings")
}

model CatalogMake {
  id     String         @id @default(uuid()) @db.Uuid
  name   String         @unique @db.VarChar(60)
  models CatalogModel[]

  @@map("catalog_makes")
}

model CatalogModel {
  id       String      @id @default(uuid()) @db.Uuid
  makeId   String      @map("make_id") @db.Uuid
  make     CatalogMake @relation(fields: [makeId], references: [id], onDelete: Cascade)
  name     String      @db.VarChar(60)
  vehicles Vehicle[]

  @@unique([makeId, name])
  @@map("catalog_models")
}

/// Maintenance catalog (seeded by migration). User-facing texts live in the frontend by code.
model MaintenanceType {
  code                   MaintenanceTypeCode         @id
  intervalKm             Int?                        @map("interval_km")
  intervalMonths         Int?                        @map("interval_months")
  fuelTypes              FuelType[]                  @map("fuel_types")
  appliesWhenFuelUnknown Boolean                     @map("applies_when_fuel_unknown")
  severeUsageSensitive   Boolean                     @map("severe_usage_sensitive")
  sortOrder              Int                         @map("sort_order")
  settings               VehicleMaintenanceSetting[]
  serviceItems           ServiceRecordItem[]
  estimates              MaintenanceEstimate[]
  noticeStates           MaintenanceNoticeState[]
  notices                Notice[]

  @@map("maintenance_types")
}

/// Per-vehicle customization of a maintenance type; no row = defaults.
model VehicleMaintenanceSetting {
  vehicleId            String              @map("vehicle_id") @db.Uuid
  vehicle              Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  typeCode             MaintenanceTypeCode @map("type_code")
  type                 MaintenanceType     @relation(fields: [typeCode], references: [code])
  enabled              Boolean             @default(true)
  customIntervalKm     Int?                @map("custom_interval_km")
  customIntervalMonths Int?                @map("custom_interval_months")
  priorKm              Int?                @map("prior_km")
  priorDate            DateTime?           @map("prior_date") @db.Date
  priorUnknown         Boolean             @default(false) @map("prior_unknown")
  snoozedUntil         DateTime?           @map("snoozed_until") @db.Date
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([vehicleId, typeCode])
  @@map("vehicle_maintenance_settings")
}

model ServiceRecord {
  /// Generated on the client; idempotency key.
  id          String              @id @db.Uuid
  vehicleId   String              @map("vehicle_id") @db.Uuid
  vehicle     Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  performedAt DateTime            @map("performed_at") @db.Timestamptz(3)
  odometerKm  Int                 @map("odometer_km")
  notes       String?             @db.VarChar(500)
  /// Reading created by this service (FR-012a).
  readingId   String?             @unique @map("reading_id") @db.Uuid
  reading     MileageReading?     @relation(fields: [readingId], references: [id], onDelete: SetNull)
  items       ServiceRecordItem[]
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([vehicleId, performedAt(sort: Desc)])
  @@map("service_records")
}

model ServiceRecordItem {
  serviceRecordId String              @map("service_record_id") @db.Uuid
  service         ServiceRecord       @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  typeCode        MaintenanceTypeCode @map("type_code")
  type            MaintenanceType     @relation(fields: [typeCode], references: [code])

  @@id([serviceRecordId, typeCode])
  @@index([typeCode, serviceRecordId])
  @@map("service_record_items")
}

/// Engine output (research R2): only values that do not depend on "today".
model MaintenanceEstimate {
  vehicleId       String              @map("vehicle_id") @db.Uuid
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  typeCode        MaintenanceTypeCode @map("type_code")
  type            MaintenanceType     @relation(fields: [typeCode], references: [code])
  baselineSource  BaselineSource      @map("baseline_source")
  baselineKm      Int                 @map("baseline_km")
  baselineAt      DateTime            @map("baseline_at") @db.Timestamptz(3)
  intervalKm      Int?                @map("interval_km")
  intervalMonths  Int?                @map("interval_months")
  intervalSource  IntervalSource      @map("interval_source")
  dueKm           Int?                @map("due_km")
  dueByTimeAt     DateTime?           @map("due_by_time_at") @db.Timestamptz(3)
  paceKmPerDay    Decimal             @map("pace_km_per_day") @db.Decimal(8, 2)
  paceSource      PaceSource          @map("pace_source")
  paceUsageType   UsageType?          @map("pace_usage_type")
  paceWindowDays  Int?                @map("pace_window_days")
  estimatedByKmAt DateTime?           @map("estimated_by_km_at") @db.Timestamptz(3)
  estimatedDueAt  DateTime?           @map("estimated_due_at") @db.Timestamptz(3)
  limitingFactor  LimitingFactor?     @map("limiting_factor")
  computedAt      DateTime            @map("computed_at") @db.Timestamptz(3)

  @@id([vehicleId, typeCode])
  @@index([estimatedDueAt])
  @@map("maintenance_estimates")
}

model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique @db.VarChar(2048)
  p256dh        String    @db.VarChar(200)
  auth          String    @db.VarChar(100)
  userAgent     String?   @map("user_agent") @db.VarChar(300)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Notification cycle per vehicle and maintenance (research R7).
model MaintenanceNoticeState {
  vehicleId          String              @map("vehicle_id") @db.Uuid
  vehicle            Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  typeCode           MaintenanceTypeCode @map("type_code")
  type               MaintenanceType     @relation(fields: [typeCode], references: [code])
  cycleSignature     String              @map("cycle_signature") @db.VarChar(200)
  lastNotifiedStatus NotifiedStatus?     @map("last_notified_status")
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([vehicleId, typeCode])
  @@map("maintenance_notice_states")
}

model Notice {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  user           Profile              @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId      String               @map("vehicle_id") @db.Uuid
  vehicle        Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind           NoticeKind
  /// Null for MILEAGE_UPDATE.
  typeCode       MaintenanceTypeCode? @map("type_code")
  type           MaintenanceType?     @relation(fields: [typeCode], references: [code])
  cycleKey       String               @map("cycle_key") @db.VarChar(200)
  remainingKm    Int?                 @map("remaining_km")
  overdueDays    Int?                 @map("overdue_days")
  estimatedDueAt DateTime?            @map("estimated_due_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt    DateTime?            @map("delivered_at") @db.Timestamptz(3)
  deliveries     DeliveryNotice[]

  @@index([userId, deliveredAt])
  @@index([createdAt])
  @@map("notices")
}

model Delivery {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  user              Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           DeliveryChannel
  digestDate        DateTime         @map("digest_date") @db.Date
  /// Push subscription id or "email".
  target            String           @db.VarChar(64)
  status            DeliveryStatus
  providerMessageId String?          @map("provider_message_id") @db.VarChar(200)
  error             String?          @db.VarChar(500)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  notices           DeliveryNotice[]

  @@unique([userId, channel, digestDate, target])
  @@index([providerMessageId])
  @@index([createdAt])
  @@map("deliveries")
}

model DeliveryNotice {
  deliveryId String   @map("delivery_id") @db.Uuid
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  noticeId   String   @map("notice_id") @db.Uuid
  notice     Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@id([deliveryId, noticeId])
  @@map("delivery_notices")
}
